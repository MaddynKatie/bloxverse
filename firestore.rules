rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users - public read, authenticated write to own doc
    // ALSO allow another user to update only the 'friends' array field (for mutual accept)
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Allow another authenticated user to only add to the friends array
      // (needed when accepting a friend request updates both users' docs)
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends'])
        && request.resource.data.friends.hasAll(resource.data.friends); // can only add, not remove
    }

    // Friend requests
    match /friendRequests/{requestId} {
      allow read: if request.auth != null
        && (resource.data.to == request.auth.uid
         || resource.data.from == request.auth.uid);

      allow create: if request.auth != null
        && request.resource.data.from == request.auth.uid
        && request.resource.data.status == 'pending';  // enforce initial status

      // Recipient can update status field only (accept/decline)
      // Sender can update to cancel (set status to 'cancelled')
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && (
          // Recipient accepts or declines
          (resource.data.to == request.auth.uid
            && request.resource.data.status in ['accepted', 'declined'])
          ||
          // Sender cancels
          (resource.data.from == request.auth.uid
            && request.resource.data.status == 'cancelled')
        );

      allow delete: if request.auth != null
        && (resource.data.to == request.auth.uid
         || resource.data.from == request.auth.uid);
    }

    // Presence
    match /presence/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Games - public read only
    match /games/{gameId} {
      allow read: if true;
      allow write: if false;
    }
  }
}