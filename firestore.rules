rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the requesting user is an admin
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/roles/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.get('role', '') == 'admin' ||
          'admin' in get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.get('roles', [])
        );
    }

    // User profiles: owner + mutual relationship writes (friends, followers, following)
    // Admins can also write (for BUX management etc.)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        isAdmin() ||
        request.auth.uid in request.resource.data.friends ||
        request.auth.uid in request.resource.data.followers ||
        request.auth.uid in request.resource.data.following ||
        (resource != null && (
          request.auth.uid in resource.data.friends ||
          request.auth.uid in resource.data.followers ||
          request.auth.uid in resource.data.following
        ))
      );
    }

    // Presence: any authenticated user can read/write their own
    match /presence/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Game stats: anyone can read and write (visit counters need no auth)
    match /gameStats/{gameId} {
      allow read: if true;
      allow write: if true;
    }

    // Published games: anyone can read; authenticated users can create
    match /publishedGames/{gameId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (request.auth.uid == resource.data.authorId || isAdmin());
      allow delete: if request.auth != null && (request.auth.uid == resource.data.authorId || isAdmin());
    }

    // Friend requests: involved users can read/write
    match /friendRequests/{requestId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Roles and Bans: authenticated users can read; only admins can write
    match /roles/{userId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /bans/{userId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Bux balances are now part of the users collection.

    // Transactions: users can read their own; authenticated users can create and update (for combined logs)
    // (logTransaction is called client-side on behalf of the user)
    match /transactions/{txId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    // Game visit tracking: any authenticated user can mark a visit
    match /gameVisits/{gameId}/visitors/{visitorId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == visitorId;
    }

    // Support requests: any user can create; only admins can read/update/delete
    match /supportRequests/{reqId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Counters: any authenticated user can read/write (transaction ensures atomicity)
    // Protect against reset: new value must be greater than current value
    match /counters/{counterId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        resource == null ||
        request.resource.data.current > resource.data.current
      );
    }

    // User ID number lookup: any authenticated user can read; only the user
    // who owns the UID can create/update their own mapping
    match /userIds/{num} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // Username lookup: publicly readable so unauthenticated users can log in
    match /usernames/{usernameLower} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null;
    }

    // Default: deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
